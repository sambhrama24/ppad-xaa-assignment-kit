{
  "name": "xaa-agent-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP tool that validates an ID-JAG (XAA) assertion and performs a governed read against the PPAD / App B resource stubs.",
  "engines": { "node": ">=20" },
  "scripts": {
