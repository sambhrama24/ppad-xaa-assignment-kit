# --- Identity (the IdP contract) ---------------------------------------------
# Path to the kit's issuer config: issuer, per-resource audience/resource/url,
# alg, kid, and the JWKS URI. This is the source of truth for token validation —
# nothing about the IdP is hard-coded in our source.
ISSUER_CONFIG_PATH=../identity-fixtures/issuer-config.json

# Optional: validate signatures OFFLINE against a local JWKS file instead of
# fetching jwks_uri over HTTP. When set, this wins over the remote URI. The kit
# ships the matching JWKS here. (XAA/README explicitly values offline validation.)
JWKS_PATH=../identity-fixtures/jwks.json

# --- Resource stubs (our service's own config) -------------------------------
# Base URLs are read from issuer-config.json (resources.<name>.url) by default;
# override here if you run the stubs elsewhere.
# STUB_PPAD_URL=http://localhost:4010
# STUB_APPB_URL=http://localhost:4011

# Service credential + tenant the stub expects (INTEGRATION-NOTE.md).
STUB_SERVICE_KEY=dev-stub-service-key
WORKSPACE_ID=ws_acme

# --- Composition policy: the agent overlay -----------------------------------
# Comma-separated client_ids that are approved to act (the thin agent allow list
# layered on top of PPAD's human allow list). An agent NOT in this list is denied
# even when its human principal is allowed.
# UNSET  => the shipped default applies (config/default.json)
# ""     => overlay disabled: pure inheritance (any agent rides its principal)
# APPROVED_AGENTS=client_research_assistant
