{
  "name": "ppad-xaa-assignment-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Self-contained assignment kit for the PPAD x Cross App Access (XAA) agent-identity take-home. Provides a PPAD-like resource stub, a local fake IdP (JWKS + token mint), sample ID-JAG tokens, and contract tests. Candidates build their own MCP tool/service against this substrate.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/generate-keys.ts",
    "start": "tsx ppad-stub/src/server.ts",
    "mint": "tsx identity-fixtures/mint-token.ts",
    "mint:all": "tsx identity-fixtures/mint-token.ts --all",
    "mint:commit": "tsx identity-fixtures/mint-token.ts --all --commit",
    "test": "vitest run ppad-stub identity-fixtures",
    "test:contract": "vitest run contract-tests"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
